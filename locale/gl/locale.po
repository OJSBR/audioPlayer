msgid "plugins.generic.audioPlayer.displayName"
msgstr "Reprodutor de audiolibros"

msgid "plugins.generic.audioPlayer.description"
msgstr "Engade un botón de reprodución a cada ficheiro de audio da páxina do libro, cunha barra de reprodutor, desprazamento dentro da pista, reprodución continua, velocidade axustable e retomada desde onde a persoa oínte parou. O botón de descarga non se modifica."

msgid "plugins.generic.audioPlayer.play"
msgstr "Reproducir"

msgid "plugins.generic.audioPlayer.pause"
msgstr "Pausa"

msgid "plugins.generic.audioPlayer.previous"
msgstr "Pista anterior"

msgid "plugins.generic.audioPlayer.next"
msgstr "Pista seguinte"

msgid "plugins.generic.audioPlayer.close"
msgstr "Pechar o reprodutor"

msgid "plugins.generic.audioPlayer.speed"
msgstr "Velocidade"

msgid "plugins.generic.audioPlayer.seek"
msgstr "Posición na pista"

msgid "plugins.generic.audioPlayer.player"
msgstr "Reprodutor de audio"

msgid "plugins.generic.audioPlayer.error"
msgstr "Non foi posible reproducir este ficheiro."

msgid "plugins.generic.audioPlayer.settings.description"
msgstr "Estas opcións aplícanse a todos os libros con ficheiros de audio desta editorial."

msgid "plugins.generic.audioPlayer.settings.autoplayNext"
msgstr "Reproducir a pista seguinte automaticamente cando unha remata"

msgid "plugins.generic.audioPlayer.settings.rememberPosition"
msgstr "Lembrar onde parou a persoa oínte en cada pista (gárdase no seu navegador)"

msgid "plugins.generic.audioPlayer.settings.defaultSpeed"
msgstr "Velocidade de reprodución inicial"
