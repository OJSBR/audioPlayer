msgid "plugins.generic.audioPlayer.displayName"
msgstr "Reproductor d'audiollibres"

msgid "plugins.generic.audioPlayer.description"
msgstr "Afegeix un botó de reproducció a cada fitxer d'àudio de la pàgina del llibre, amb barra de reproductor, cerca dins de la pista, reproducció contínua, velocitat ajustable i represa des d'on l'oient es va aturar. El botó de baixada no es modifica."

msgid "plugins.generic.audioPlayer.play"
msgstr "Reprodueix"

msgid "plugins.generic.audioPlayer.pause"
msgstr "Pausa"

msgid "plugins.generic.audioPlayer.previous"
msgstr "Pista anterior"

msgid "plugins.generic.audioPlayer.next"
msgstr "Pista següent"

msgid "plugins.generic.audioPlayer.close"
msgstr "Tanca el reproductor"

msgid "plugins.generic.audioPlayer.speed"
msgstr "Velocitat"

msgid "plugins.generic.audioPlayer.seek"
msgstr "Posició a la pista"

msgid "plugins.generic.audioPlayer.player"
msgstr "Reproductor d'àudio"

msgid "plugins.generic.audioPlayer.error"
msgstr "No s'ha pogut reproduir aquest fitxer."

msgid "plugins.generic.audioPlayer.settings.description"
msgstr "Aquestes opcions s'apliquen a tots els llibres amb fitxers d'àudio d'aquesta editorial."

msgid "plugins.generic.audioPlayer.settings.autoplayNext"
msgstr "Reprodueix la pista següent automàticament quan una acaba"

msgid "plugins.generic.audioPlayer.settings.rememberPosition"
msgstr "Recorda on es va aturar l'oient a cada pista (es desa al seu navegador)"

msgid "plugins.generic.audioPlayer.settings.defaultSpeed"
msgstr "Velocitat de reproducció inicial"
